# Pixel Office configuration
# Copy this file to .env and adjust values as needed.

# HTTP server port
PORT=19001

# Scene Preset (Default: tmf = Micro Taiwan Index Futures / 微台指期貨戰情室; alias: quant-trading)
# Expandable by adding sample-data/map.<preset>.json & sample-data/agents.<preset>.json (e.g. podcast-studio, dev-team)
PRESET=tmf

# Set to 1 to force overwrite data/map.json & data/agents.json from sample-data/<PRESET> on startup
FORCE_PRESET=0

# Optional Gemini API key fallback for the dashboard
GEMINI_API_KEY=

# Directory for runtime data (logs, cached config, agent messages, etc.)
PIXEL_DATA_DIR=./data

# Admin password for the Pixel dashboard login
DASHBOARD_PASSWORD=pixeladmin
